                      cachedDataType="wstr"
                      cachedLength="500"
                      cachedName="customer_name_clean"
                      lineageId="Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_name_clean]" />
                    <inputColumn
                      refId="Package\DFT_Load_Customers\Conditional Split.Inputs[Conditional Split Input].Columns[email_clean]"
                      cachedDataType="wstr"
                      cachedLength="500"
                      cachedName="email_clean"
                      lineageId="Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[email_clean]" />
                    <inputColumn
                      refId="Package\DFT_Load_Customers\Conditional Split.Inputs[Conditional Split Input].Columns[customer_id_clean]"
                      cachedDataType="wstr"
                      cachedLength="20"
                      cachedName="customer_id_clean"
                      cachedSortKeyPosition="1"
                      lineageId="Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_id_clean]" />
                  </inputColumns>
                  <externalMetadataColumns />
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\DFT_Load_Customers\Conditional Split.Outputs[ValidRows]"
                  description="Output 1 of the Conditional Split Transformation"
                  errorOrTruncationOperation="Computation"
                  errorRowDisposition="FailComponent"
                  exclusionGroup="1"
                  name="ValidRows"
                  synchronousInputId="Package\DFT_Load_Customers\Conditional Split.Inputs[Conditional Split Input]"
                  truncationRowDisposition="FailComponent">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">![ISNULL](#{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_id_clean]}) &amp;&amp; #{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_name_clean]} != "invalid_name" &amp;&amp; #{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[email_clean]} != "not_provided"</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">!ISNULL(customer_id_clean) &amp;&amp; customer_name_clean != "invalid_name" &amp;&amp; email_clean != "not_provided"</property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the position of the condition in the list of conditions that the transformation evaluates. The evaluation order is from the lowest to the highest value."
                      name="EvaluationOrder">0</property>
                  </properties>
                  <externalMetadataColumns />
                </output>
                <output
                  refId="Package\DFT_Load_Customers\Conditional Split.Outputs[InvalidRows]"
                  description="Output 2 of the Conditional Split Transformation"
                  errorOrTruncationOperation="Computation"
                  errorRowDisposition="FailComponent"
                  exclusionGroup="1"
                  name="InvalidRows"
                  synchronousInputId="Package\DFT_Load_Customers\Conditional Split.Inputs[Conditional Split Input]"
                  truncationRowDisposition="FailComponent">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">#{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_id_clean]} == "invalid_id" || #{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[customer_name_clean]} == "invalid_name" || #{Package\DFT_Load_Customers\Sort.Outputs[Sort Output].Columns[email_clean]} == "invalid_email"</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">customer_id_clean == "invalid_id" || customer_name_clean == "invalid_name" || email_clean == "invalid_email"</property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the position of the condition in the list of conditions that the transformation evaluates. The evaluation order is from the lowest to the highest value."
                      name="EvaluationOrder">1</property>
                  </properties>
                  <externalMetadataColumns />
                </output>
